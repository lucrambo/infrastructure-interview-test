# Local development settings, read by `yarn start` and `yarn migration:*` when copied to `.env`.
# They match compose.yaml. Deployed environments set these variables directly and ship no file.
PORT=3000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=posts
DB_PASSWORD=posts
DB_NAME=posts
DB_SSL=false
DB_POOL_MAX=10
SHUTDOWN_TIMEOUT_MS=25000
